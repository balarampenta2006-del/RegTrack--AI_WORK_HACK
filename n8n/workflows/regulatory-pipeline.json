      "parameters": {
        "resource": "message",
        "operation": "send",
        "sendTo": "={{ String($json.emailRecipients || 'yellapukiranmaigangotree@gmail.com, balaram.penta2006@gmail.com').split(',').map((s) => s.trim()).filter((s) => s.length > 0).join(', ') }}",
        "subject": "={{ '[' + ($json.sourceCode || 'REG') + '] ' + ($json.regulationTitle || 'Regulatory update') }}",
        "emailType": "text",
        "message": "={{ ['Regulatory update alert' + ($json.sourceCode ? ' - ' + $json.sourceCode : ''), '', 'Regulation: ' + ($json.regulationTitle || 'Untitled regulation'), 'Company: ' + ($json.companyName || 'n/a'), 'Risk / relevance: ' + ($json.relevance || 'n/a'), '', 'AI summary:', String($json.summary || 'No summary available.'), '', 'Required action:', String($json.requiredAction || 'See the source link below.'), '', 'Effective date: ' + ($json.effectiveDate || 'not specified'), 'Affected areas: ' + ($json.affectedAreas || 'n/a'), 'Source link: ' + ($json.regulationUrl || 'n/a'), 'Alert ID: ' + $json.id, '', 'Sent automatically by the regtrack n8n regulatory pipeline at ' + new Date().toISOString()].join('\\n') }}",
        "options": {}
      }
    },
    {
      "id": "a1000001-0000-4000-8000-000000000016",
