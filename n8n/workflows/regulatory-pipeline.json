    {
      "id": "a1000001-0000-4000-8000-000000000004",
      "name": "Save Auth Token",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [920, 340],
      "parameters": {
        "jsCode": "const first = $input.first().json;\nreturn [{ json: Object.assign({}, first, { token: first.token || null }) }];"
      }
    },
    {
      "id": "a1000001-0000-4000-8000-000000000005",
      "name": "Fetch Events",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1140, 340],
      "onError": "continueRegularOutput",
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 3000,
      "alwaysOutputData": true,
      "parameters": {
        "method": "GET",
        "url": "http://backend:8080/api/events",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $('Save Auth Token').item.json.token }}"
            }
          ]
        },
        "options": {
          "timeout": 20000
        }
      }
    },
    {
      "id": "a1000001-0000-4000-8000-000000000006",
      "name": "Filter New Events",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1360, 340],
      "parameters": {
        "jsCode": "const sd = $getWorkflowStaticData('global');\nconst watermark = Number(sd.lastEventId || 0);\nlet payload = $input.first().json;\nif (!Array.isArray(payload)) {\n  payload = payload.content || payload.events || payload.data || payload.items || [];\n}\nif (!Array.isArray(payload)) {\n  payload = [];\n}\nconst fresh = payload\n  .filter((e) => e && e.id != null && e.status === 'RECEIVED')\n  .map((e) => Object.assign({}, e, { _eventId: Number(e.id) }))\n  .filter((e) => e._eventId > watermark)\n  .sort((a, b) => a._eventId - b._eventId);\nif (fresh.length === 0) {\n  return [{ json: { noNewEvents: true, watermark: watermark, checkedAt: new Date().toISOString() } }];\n}\nreturn fresh.map((e) => ({ json: Object.assign({}, e, { noNewEvents: false }) }));"
      }
    },
    {
      "id": "a1000001-0000-4000-8000-000000000007",
      "name": "Has New Events?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1580, 340],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "cond-new-events-0001",
              "leftValue": "={{ $json.noNewEvents }}",
              "rightValue": false,
              "operator": {
                "type": "boolean",
                "operation": "equals",
                "singleValue": false
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "a1000001-0000-4000-8000-000000000008",
      "name": "Process Document",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1800, 240],
      "onError": "continueRegularOutput",
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 5000,
      "parameters": {
