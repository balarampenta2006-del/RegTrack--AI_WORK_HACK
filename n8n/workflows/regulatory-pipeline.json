        "url": "http://docproc:8102/process",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ input: $json.payloadUrl, regulation_id: $json.regulationId, version_no: 1, source: $json.sourceCode }) }}",
        "options": {
          "timeout": 300000
        }
      }
    },
    {
      "id": "a1000001-0000-4000-8000-000000000009",
      "name": "Analyze Regulation",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2020, 240],
      "onError": "continueRegularOutput",
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 5000,
      "parameters": {
        "method": "POST",
        "url": "http://ai:8103/analyze",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ regulation_id: $json.regulation_id != null ? $json.regulation_id : $('Filter New Events').item.json.regulationId, version_no: $json.version_no != null ? $json.version_no : 1, event_id: $('Filter New Events').item.json.id }) }}",
        "options": {
          "timeout": 300000
        }
      }
    },
    {
      "id": "a1000001-0000-4000-8000-000000000010",
      "name": "Reduce To One Item",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2240, 240],
      "parameters": {
        "jsCode": "return [{ json: { step: 'event-processing-complete', at: new Date().toISOString() } }];"
      }
    },
    {
      "id": "a1000001-0000-4000-8000-000000000011",
      "name": "Record Watermark",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2460, 240],
      "parameters": {
        "jsCode": "const sd = $getWorkflowStaticData('global');\nlet maxId = Number(sd.lastEventId || 0);\ntry {\n  const items = $('Filter New Events').all();\n  for (const it of items) {\n    const id = Number(it.json.id || 0);\n    if (id > maxId) {\n      maxId = id;\n    }\n  }\n} catch (e) {}\nsd.lastEventId = maxId;\nreturn [{ json: { lastEventId: maxId, recordedAt: new Date().toISOString() } }];"
      }
    },
    {
      "id": "a1000001-0000-4000-8000-000000000012",
      "name": "Fetch Pending Alerts",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2680, 340],
