    {
      "id": "a1000001-0000-4000-8000-000000000013",
      "name": "Normalize Alerts",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2900, 340],
      "parameters": {
        "jsCode": "let payload = $input.first().json;\nif (!Array.isArray(payload)) {\n  payload = payload.content || payload.data || payload.items || payload.alerts || [];\n}\nif (!Array.isArray(payload)) {\n  payload = [];\n}\nreturn payload.filter((a) => a && a.id != null).map((a) => ({ json: a }));"
      }
    },
