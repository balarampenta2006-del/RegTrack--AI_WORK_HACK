      "name": "Email Send Failed",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [3340, 460],
      "parameters": {
        "jsCode": "let alert = {};\ntry {\n  alert = $('Normalize Alerts').item.json;\n} catch (e) {\n  alert = {};\n}\nconst src = $input.first().json || {};\nreturn [{ json: { email_failed: true, alert_id: alert.id || null, reason: src.message || src.error || 'gmail send failed', at: new Date().toISOString() } }];"
      }
    }
